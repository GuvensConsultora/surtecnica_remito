<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ LISTA DEL INDICADOR ============ -->
    <record id="view_picking_tree_plazo" model="ir.ui.view">
        <field name="name">stock.picking.tree.plazo</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <!-- El estado va como texto, nunca como color solo: el color no alcanza
                 para distinguir "dentro del plazo" de "excedido". -->
            <tree string="Plazo de facturación" create="false" default_order="guvens_remito_fecha desc">
                <field name="name" string="Remito"/>
                <field name="guvens_remito_number" string="Nº talonario"/>
                <field name="partner_id" string="Cliente"/>
                <field name="guvens_remito_fecha" string="Confeccionado"/>
                <field name="guvens_factura_id" string="Factura"/>
                <field name="guvens_dias_a_factura" string="Días hábiles" avg="Promedio"/>
                <field name="guvens_dias_sin_facturar" string="Esperando" avg="Promedio"
                       optional="show"/>
                <field name="guvens_motivo_no_facturado" string="Motivo" optional="show"/>
                <field name="guvens_valor_sin_facturar_ars" string="Valor sin facturar"
                       sum="Total" optional="hide"/>
                <field name="guvens_remito_requiere_hes" string="HES" optional="show"/>
                <field name="guvens_plazo_estado" string="Estado"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ============ MATRIZ ============ -->
    <record id="view_picking_pivot_plazo" model="ir.ui.view">
        <field name="name">stock.picking.pivot.plazo</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <pivot string="Plazo de facturación" sample="0">
                <!-- Por cliente y con las DOS medidas: el promedio de lo facturado
                     solo no alcanza, porque el que nunca factura no tiene días que
                     promediar y queda fuera del ranking. -->
                <field name="partner_id" type="row"/>
                <field name="guvens_plazo_estado" type="col"/>
                <field name="guvens_dias_a_factura" type="measure"/>
                <field name="guvens_dias_sin_facturar" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_picking_graph_plazo" model="ir.ui.view">
        <field name="name">stock.picking.graph.plazo</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <graph string="Plazo de facturación" type="bar" sample="0">
                <field name="guvens_remito_fecha" interval="month"/>
                <field name="guvens_dias_a_factura" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============ BUSQUEDA ============ -->
    <record id="view_picking_search_plazo" model="ir.ui.view">
        <field name="name">stock.picking.search.plazo</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Plazo de facturación">
                <field name="guvens_remito_number" string="Nº de talonario"/>
                <field name="partner_id"/>
                <field name="guvens_factura_id"/>

                <filter name="excedido" string="Excedidos"
                        domain="[('guvens_plazo_estado', '=', 'excedido')]"/>
                <filter name="en_plazo" string="Dentro del plazo"
                        domain="[('guvens_plazo_estado', '=', 'en_plazo')]"/>
                <filter name="pendiente" string="Pendientes de facturar"
                        domain="[('guvens_plazo_estado', '=', 'pendiente')]"/>
                <separator/>
                <filter name="sin_motivo" string="Sin motivo cargado"
                        domain="[('guvens_plazo_estado', '=', 'pendiente'),
                                 ('guvens_motivo_no_facturado', '=', False)]"
                        help="Remitos sin facturar de los que todavía no sabemos por qué."/>
                <filter name="esperando" string="Esperando hace más de 5 días"
                        domain="[('guvens_dias_sin_facturar', '>', 5)]"
                        help="Remitos sin factura, ordenados por lo que llevan esperando.
                              Es la parte que el promedio de los facturados no muestra."/>
                <separator/>
                <!-- El corte que pidió Franco: comparar los dos grupos. Va por el
                     tilde del remito y no por la lista del cliente, porque un cliente
                     puede tener remitos de los dos tipos. -->
                <filter name="con_hes" string="Esperan HES / autorización"
                        domain="[('guvens_remito_requiere_hes', '=', True)]"/>
                <filter name="sin_hes" string="Sin HES"
                        domain="[('guvens_remito_requiere_hes', '=', False)]"/>
                <separator/>
                <filter name="sin_factura_aun" string="Sin facturar (todos)"
                        domain="[('guvens_plazo_estado', 'in', ['pendiente', 'no_factura'])]"
                        help="Lo entregado que todavía no tiene factura, incluidos los
                              que no la van a tener."/>
                <filter name="valor_incompleto" string="Valor incompleto"
                        domain="[('guvens_valor_incompleto', '=', True)]"
                        help="Remitos con algún renglón sin línea de pedido detrás: no
                              hay precio de dónde sacarlo y ese renglón no suma."/>
                <separator/>
                <filter name="revisar" string="Para revisar a mano"
                        domain="[('guvens_plazo_estado', 'in', ['indeterminado', 'previo'])]"
                        help="Pedidos con varias entregas o varias facturas, y los que
                              se facturaron antes de entregar."/>

                <group expand="0" string="Agrupar por">
                    <filter name="g_estado" string="Estado del plazo"
                            context="{'group_by': 'guvens_plazo_estado'}"/>
                    <filter name="g_cliente" string="Cliente"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="g_hes" string="HES / autorización"
                            context="{'group_by': 'guvens_remito_requiere_hes'}"/>
                    <filter name="g_motivo" string="Motivo de que no esté facturado"
                            context="{'group_by': 'guvens_motivo_no_facturado'}"/>
                    <filter name="g_moneda" string="Moneda del pedido"
                            context="{'group_by': 'guvens_valor_moneda_id'}"/>
                    <filter name="g_mes" string="Mes del remito"
                            context="{'group_by': 'guvens_remito_fecha:month'}"/>
                    <filter name="g_compania" string="Compañía"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ ACCION Y MENU ============ -->
    <record id="action_plazo_facturacion" model="ir.actions.act_window">
        <field name="name">Plazo de facturación</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,pivot,graph,form</field>
        <field name="domain">[('guvens_remito_fecha', '!=', False)]</field>
        <field name="search_view_id" ref="view_picking_search_plazo"/>
        <field name="context">{'search_default_g_estado': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no hay remitos con fecha de confección
            </p>
            <p>
                El reloj de cada remito arranca cuando se carga el número del
                talonario. Acá aparecen los que ya lo tienen, con los días hábiles
                que pasaron hasta la factura.
            </p>
        </field>
    </record>

    <record id="action_plazo_facturacion_tree" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_picking_tree_plazo"/>
        <field name="act_window_id" ref="action_plazo_facturacion"/>
    </record>
    <record id="action_plazo_facturacion_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_picking_pivot_plazo"/>
        <field name="act_window_id" ref="action_plazo_facturacion"/>
    </record>
    <record id="action_plazo_facturacion_graph" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_picking_graph_plazo"/>
        <field name="act_window_id" ref="action_plazo_facturacion"/>
    </record>

    <menuitem id="menu_plazo_facturacion"
              name="Plazo de facturación"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_plazo_facturacion"
              sequence="8"/>

    <!-- ============ ENTREGADO Y NO FACTURADO ============ -->
    <!-- El saldo que hoy no está en ninguna cuenta corriente: la entrega salió y no
         hay factura, así que no hay asiento. El dato vive en el pedido y acá se
         muestra por cliente. Este informe no registra nada: es lectura. -->
    <record id="view_picking_tree_valor" model="ir.ui.view">
        <field name="name">stock.picking.tree.valor.sin.facturar</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <tree string="Entregado sin facturar" create="false"
                  default_order="guvens_valor_sin_facturar_ars desc">
                <field name="name" string="Remito"/>
                <field name="guvens_remito_number" string="Nº talonario"/>
                <field name="partner_id" string="Cliente"/>
                <field name="guvens_remito_fecha" string="Confeccionado"/>
                <field name="guvens_dias_sin_facturar" string="Esperando" avg="Promedio"/>
                <field name="guvens_motivo_no_facturado" string="Motivo"/>
                <!-- Las dos columnas de valor, y sólo una se totaliza. La de origen
                     está en la moneda de cada pedido: sumarla mezclaría dólares con
                     pesos. -->
                <field name="guvens_valor_sin_facturar" string="Valor (moneda del pedido)"/>
                <field name="guvens_valor_moneda_id" string="Moneda" optional="show"/>
                <field name="guvens_valor_sin_facturar_ars" string="Valor en pesos"
                       sum="Total"/>
                <field name="guvens_valor_incompleto" string="Valor incompleto"
                       optional="show"/>
                <field name="guvens_plazo_estado" string="Estado" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_picking_pivot_valor" model="ir.ui.view">
        <field name="name">stock.picking.pivot.valor.sin.facturar</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <pivot string="Entregado sin facturar" sample="0">
                <!-- Cliente contra motivo: separa lo que está demorado de lo que no
                     lleva comprobante, que son dos saldos distintos aunque sumen. -->
                <field name="partner_id" type="row"/>
                <field name="guvens_motivo_no_facturado" type="col"/>
                <field name="guvens_valor_sin_facturar_ars" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_valor_sin_facturar" model="ir.actions.act_window">
        <field name="name">Entregado sin facturar</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,pivot,form</field>
        <!-- Los cancelados quedan afuera: un remito anulado no es un saldo a cobrar.
             Medido en testing el 21/10/2026, WH/OUT/02388 aparecía en la lista. -->
        <field name="domain">[('guvens_plazo_estado', 'in', ['pendiente', 'no_factura']),
                              ('state', '!=', 'cancel')]</field>
        <field name="search_view_id" ref="view_picking_search_plazo"/>
        <field name="context">{'search_default_g_cliente': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay entregas sin facturar
            </p>
            <p>
                Acá aparece lo que salió con remito y todavía no tiene factura,
                valorizado con el precio de su pedido y agrupado por cliente.
                Incluye los remitos marcados como «no se factura»: son los que no
                van a tener comprobante y cuyo saldo igual hay que seguir.
            </p>
        </field>
    </record>

    <record id="action_valor_sin_facturar_tree" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_picking_tree_valor"/>
        <field name="act_window_id" ref="action_valor_sin_facturar"/>
    </record>
    <record id="action_valor_sin_facturar_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_picking_pivot_valor"/>
        <field name="act_window_id" ref="action_valor_sin_facturar"/>
    </record>

    <menuitem id="menu_valor_sin_facturar"
              name="Entregado sin facturar"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_valor_sin_facturar"
              sequence="9"/>

</odoo>
